{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_origin": {
      "enum": [
        "real",
        "fixture"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "interval_ns": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9000000000000000.0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "max_gap_ns": {
      "type": "integer",
      "minimum": 1
    },
    "numeric_epsilon_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 1e-06
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "integer",
            "minimum": 1
          },
          "radius_m": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000.0
          },
          "center_offset_xyz": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            },
            "minItems": 3,
            "maxItems": 3
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t_ns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9000000000000000.0
                },
                "entity_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "frame": {
                  "type": "string",
                  "minLength": 1
                },
                "epoch": {
                  "type": "string",
                  "minLength": 1
                },
                "xyz": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000.0,
                    "maximum": 1000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "quaternion_xyzw": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000.0,
                    "maximum": 1000000.0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "center_xyz": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000.0,
                    "maximum": 1000000.0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "seq": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pose_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9000000000000000.0
                    }
                  },
                  "required": [
                    "file",
                    "line",
                    "seq",
                    "pose_index"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "t_ns",
                "entity_id",
                "frame",
                "epoch",
                "xyz",
                "quaternion_xyzw",
                "center_xyz",
                "source"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "entity_id",
          "radius_m",
          "center_offset_xyz",
          "samples"
        ],
        "additionalProperties": false
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "physical_error_bound_m": {
      "type": "null"
    }
  },
  "required": [
    "schema_version",
    "record_origin",
    "run_id",
    "frame",
    "epoch",
    "interval_ns",
    "max_gap_ns",
    "numeric_epsilon_m",
    "objects",
    "pairs",
    "physical_error_bound_m"
  ],
  "additionalProperties": false
}
