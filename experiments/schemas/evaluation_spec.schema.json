{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "record_origin": {
      "const": "real"
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "const": "world"
    },
    "scope": {
      "type": "object",
      "properties": {
        "interval_ns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9000000000000000.0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "rule": {
          "const": "accepted_to_max_terminal_plus_5s_or_frozen_motion_end"
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "action_lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "motion_arm_line": {
          "type": "integer",
          "minimum": 1
        },
        "terminal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "interval_ns",
        "rule",
        "uuid",
        "action_lines",
        "motion_arm_line",
        "terminal"
      ],
      "additionalProperties": false
    },
    "max_gap_ns": {
      "const": 50000000
    },
    "robot_name": {
      "type": "string",
      "minLength": 1
    },
    "obstacle_name": {
      "type": "string",
      "minLength": 1
    },
    "scene_identity": {
      "type": "object",
      "properties": {
        "models": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "links": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1
                },
                "minProperties": 1
              }
            },
            "required": [
              "id",
              "links"
            ],
            "additionalProperties": false
          }
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "models",
        "line",
        "seq"
      ],
      "additionalProperties": false
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minProperties": 1
    },
    "robot_radius_rule": {
      "const": "all_collision_3d_bound_about_model_origin"
    },
    "physical_error_bound_m": {
      "type": "null"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "record_origin",
    "epoch",
    "frame",
    "scope",
    "max_gap_ns",
    "robot_name",
    "obstacle_name",
    "scene_identity",
    "source_hashes",
    "robot_radius_rule",
    "physical_error_bound_m"
  ],
  "additionalProperties": false
}
