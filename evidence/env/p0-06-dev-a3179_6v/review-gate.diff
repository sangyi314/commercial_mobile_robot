+ };
+ [[maybe_unused]] auto service=[&](const std::string &name,const auto &req){gz::msgs::Boolean res;bool ok=false;if(!node.Request(name,req,500u,res,ok)||!ok||!res.data())throw std::runtime_error("SERVICE_REJECTED_OR_TIMEOUT");};
+ auto execute=[&](std::string op,const J &a)->J{
+  (void)a;
+  if(op=="interfaces"){
+   J j={{"services",J::object()},{"topics",J::object()}};
+   for(const auto &entry:std::vector<std::array<std::string,3>>{{"/world/default/set_pose","gz.msgs.Pose","gz.msgs.Boolean"},{"/world/default/scene/info","gz.msgs.Empty","gz.msgs.Scene"},{"/world/default/control","gz.msgs.WorldControl","gz.msgs.Boolean"}}){
+    std::vector<gz::transport::ServicePublisher> pubs;
+    if(!node.ServiceInfo(entry[0],pubs)||pubs.size()!=1||pubs[0].ReqTypeName()!=entry[1]||pubs[0].RepTypeName()!=entry[2])throw std::runtime_error("SERVICE_DISCOVERY_TYPE_MISMATCH");
+    j["services"][entry[0]]={{"request_type",pubs[0].ReqTypeName()},{"response_type",pubs[0].RepTypeName()},{"providers",pubs.size()}};
+   }
+   for(const auto &entry:std::vector<std::array<std::string,2>>{{"/world/default/pose/info","gz.msgs.Pose_V"},{"/world/default/clock","gz.msgs.Clock"},{"/world/default/stats","gz.msgs.WorldStatistics"}}){
+    std::vector<gz::transport::MessagePublisher> pubs,subs;
+    if(!node.TopicInfo(entry[0],pubs,subs)||pubs.size()!=1||pubs[0].MsgTypeName()!=entry[1])throw std::runtime_error("TOPIC_DISCOVERY_TYPE_MISMATCH");
+    j["topics"][entry[0]]={{"type",pubs[0].MsgTypeName()},{"publishers",pubs.size()}};
+   }
+   return j;
+  }
+  if(op=="status"){
+   J j={{"sim_ns",clock},{"phase",timeline.phase},{"inflight",gate.pending},{"stats_seen",stats_seen},{"paused",paused},{"pose_stamp_ns",pose_stamp},{"stats_sim_ns",stats_clock}};
+   {std::lock_guard<std::mutex> guard(mutex);j["counts"]=counts;}
+   j["entity_id"]=entity?J(*entity):J(nullptr);j["actual_xyz"]=actual?J(*actual):J(nullptr);return j;
+  }
+  if(op=="snapshot"){
+   gz::msgs::Empty req;gz::msgs::Scene res;bool ok=false;
+   if(!node.Request("/world/default/scene/info",req,500u,res,ok)||!ok)throw std::runtime_error("SCENE_SNAPSHOT_TIMEOUT");
+   receive("scene_snapshot",res);return {{"captured",true}};
+  }
+#ifndef CMR_CAPTURE
+  if(op=="arm"){
+   if(!entity||a.at("entity_id").get<uint64_t>()!=*entity)throw std::runtime_error("ENTITY_MISMATCH");
+   if(a.at("clock_epoch")!=epoch||a.at("trigger")!=ds.at("trigger"))throw std::runtime_error("TRIGGER_EPOCH");
+   if(a.at("trigger")=="goal_accepted"&&(!a.contains("uuid")||a.at("uuid").get<std::string>().size()!=32))throw std::runtime_error("GOAL_BINDING");
+   timeline.arm(a.at("event_id"),a.at("trigger_ns"),ds.at("delay_ns"));
+   save({{"kind","arm"},{"event",a},{"release_ns",timeline.release}});return {{"release_ns",timeline.release}};
+  }
+  if(op=="quiesce"){timeline.quiesced=true;return {{"quiesced",true},{"inflight",gate.pending}};}
+  if(op=="resume_requests"){if(paused)throw std::runtime_error("WORLD_STILL_PAUSED");timeline.quiesced=false;return {{"resumed",true}};}
+  if(op=="pause"||op=="unpause"){
+   if(profile.at("mode")!="probe"||!timeline.quiesced||gate.pending)throw std::runtime_error("PROBE_PAUSE_ONLY");
+   gz::msgs::WorldControl req;req.set_pause(op=="pause");service("/world/default/control",req);return {{"requested_pause",op=="pause"}};
+  }
+  if(op=="probe_place"){
+   if(profile.at("mode")!="probe"||!timeline.quiesced||!entity)throw std::runtime_error("PROBE_PLACE_ONLY");
+   auto xyz=a.at("xyz").get<Vec>();
+   for(double v:xyz)if(!std::isfinite(v))throw std::runtime_error("NONFINITE_PLACE");
+   gz::msgs::Pose req;req.set_id(*entity);req.set_name("scripted_obstacle");req.mutable_position()->set_x(xyz[0]);req.mutable_position()->set_y(xyz[1]);req.mutable_position()->set_z(xyz[2]);req.mutable_orientation()->set_w(1);
+   save({{"kind","probe_place_request"},{"sim_ns",clock},{"entity_id",*entity},{"desired_xyz",xyz},{"request",proto(req)}});service("/world/default/set_pose",req);
+   save({{"kind","probe_place"},{"sim_ns",clock},{"entity_id",*entity},{"desired_xyz",xyz},{"request",proto(req)}});return {{"service_ack",true}};
+  }
+  if(op=="contact"){
+   if(profile.at("mode")!="probe"||!timeline.quiesced||!actual)throw std::runtime_error("CONTACT_PROBE_ONLY");
+   const bool positive=a.at("positive");Vec p=*actual;
+   if(!positive){auto xy=a.at("test_xy").get<std::array<double,2>>();p[0]=xy[0];p[1]=xy[1];if(std::hypot(p[0]-(*actual)[0],p[1]-(*actual)[1])<.3)throw std::runtime_error("NEGATIVE_PROBE_OVERLAPS");}
+   std::string sdf="<sdf version='1.9'><model name='cmr_probe_ball'><pose>"+std::to_string(p[0])+" "+std::to_string(p[1])+" 1.0 0 0 0</pose><link name='body'><inertial><mass>0.1</mass><inertia><ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz></inertia></inertial><collision name='ball'><geometry><sphere><radius>0.03</radius></sphere></geometry></collision><visual name='visual'><geometry><sphere><radius>0.03</radius></sphere></geometry></visual><sensor name='contact' type='contact'><contact><collision>ball</collision></contact><topic>/cmr_probe/contacts</topic><always_on>true</always_on><update_rate>100</update_rate></sensor></link></model></sdf>";
+   gz::msgs::EntityFactory req;req.set_sdf(sdf);service("/world/default/create",req);
+   save({{"kind","contact_create"},{"positive",positive},{"test_xy",std::array<double,2>{p[0],p[1]}},{"actual_actor_xyz",*actual},{"request",proto(req)},{"sim_ns",clock}});return {{"created",true}};
+  }
+  if(op=="remove_contact"){gz::msgs::Entity req;req.set_name("cmr_probe_ball");req.set_type(gz::msgs::Entity::MODEL);service("/world/default/remove",req);return {{"removed",true}};}
+#endif
+  if(op=="exit"){if(gate.pending)throw std::runtime_error("REQUEST_INFLIGHT_AT_EXIT");running=false;return {{"exiting",true}};}
+  throw std::runtime_error("UNKNOWN_COMMAND");
