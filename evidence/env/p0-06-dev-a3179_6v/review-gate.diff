index 0000000..7c43b45
--- /dev/null
+++ b/src/cmr_sim/src/scene_client.cpp
@@ -0,0 +1,217 @@
+// Ordinary Transport client. Only the parent runner owns process lifecycle.
+#include "cmr_sim/timeline.hpp"
+#include <gz/transport/Node.hh>
+#include <gz/msgs/clock.pb.h>
+#include <gz/msgs/world_stats.pb.h>
+#include <gz/msgs/pose_v.pb.h>
+#include <gz/msgs/scene.pb.h>
+#include <gz/msgs/empty.pb.h>
+#include <gz/msgs/boolean.pb.h>
+#include <gz/msgs/world_control.pb.h>
+#include <gz/msgs/entity_factory.pb.h>
+#include <gz/msgs/entity.pb.h>
+#include <gz/msgs/contacts.pb.h>
+#include <google/protobuf/util/json_util.h>
+#include <nlohmann/json.hpp>
+#include <fstream>
+#include <iostream>
+#include <mutex>
+#include <deque>
+#include <chrono>
+#include <filesystem>
+#include <poll.h>
+#include <unistd.h>
+#include <fcntl.h>
+using J=nlohmann::json;
+using namespace cmr_sim;
+double mono(){return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();}
+template<class T> J proto(const T &m){std::string s;google::protobuf::util::JsonPrintOptions o;o.preserve_proto_field_names=true;auto result=google::protobuf::util::MessageToJsonString(m,&s,o);if(!result.ok())throw std::runtime_error("PROTOBUF_JSON");return J::parse(s);}
+J readfile(const std::filesystem::path &p){std::ifstream f(p);if(!f)throw std::runtime_error("INPUT_MISSING");J j;f>>j;return j;}
+int64_t stamp(const J &t){return std::stoll(t.value("sec",std::string("0")))*1000000000LL+t.value("nsec",0);}
+int main(int argc,char **argv){
+ uint64_t seq=0;std::string failure_run=argc==3?std::filesystem::path(argv[2]).filename().string():"unknown";
+ try {
+ if(argc!=3||std::string(argv[1])!="--run-dir"||!std::getenv("GZ_PARTITION"))throw std::runtime_error("explicit run and partition required");
+ std::filesystem::path run=argv[2];std::string id=run.filename(),epoch=id+":sim0";
+ const J profile=readfile(run/"artifacts/profile.json");[[maybe_unused]] const auto &ds=profile.at("dynamic_spec").at("dynamic");
+ J motion=readfile(run/"artifacts/dynamic_motion.json");std::vector<Knot> knots;
+ for(auto &k:motion.at("knots"))knots.push_back({k.at("t_ns"),k.at("xyz").get<Vec>()});
+ Timeline timeline(knots);timeline.hold=motion.at("hold_ns");
+#ifdef CMR_CAPTURE
+ auto path=run/"runtime/gazebo-raw.jsonl";
+#else
+ auto path=run/"runtime/motion-commands.jsonl";
+#endif
+ int fd=open(path.c_str(),O_CREAT|O_EXCL|O_WRONLY,0600);if(fd<0)throw std::runtime_error("OUTPUT_EXISTS");close(fd);
+ std::ofstream raw(path);
+ std::mutex mutex;std::deque<J> queue;std::map<std::string,size_t> counts;uint64_t rawseq=0,lastseq=0;
+ int64_t clock=-1,pose_stamp=-1,stats_clock=-1;bool paused=false,stats_seen=false,running=true;
+ RequestGate gate;double lastheart=0;std::optional<uint64_t> entity;std::optional<Vec> actual;
+ std::string input;std::map<std::string,std::pair<J,J>> cache;
+ // Node is destroyed before its callback state.
+ auto emit=[&](std::string type,J data,std::string rid=""){
+  J e={{"protocol_version",1},{"run_id",id},{"clock_epoch",epoch},{"seq",++seq},{"request_id",rid},{"type",type},{"source_monotonic_s",mono()},{"data",data}};
+  e["ros_s"]=nullptr;e["gazebo_sim_ns"]=clock>=0?J(clock):J(nullptr);std::cout<<e.dump()<<std::endl;
+ };
+ auto receive=[&](std::string kind,const auto &msg){
+  J row={{"format_version",1},{"run_id",id},{"clock_epoch",epoch},{"kind",kind},{"receive_monotonic_s",mono()},{"protobuf",proto(msg)}};
+  std::lock_guard<std::mutex> guard(mutex);
+#ifdef CMR_CAPTURE
+  row["seq"]=++rawseq;raw<<row.dump()<<'\n';raw.flush();
+#endif
+  if(queue.size()>=10000)throw std::runtime_error("INPUT_QUEUE_OVERFLOW");
+  queue.push_back(row);++counts[kind];
+ };
+ gz::transport::Node node;
+ node.Subscribe<gz::msgs::Clock>("/world/default/clock",[&](const gz::msgs::Clock &m){receive("clock",m);});
+ node.Subscribe<gz::msgs::WorldStatistics>("/world/default/stats",[&](const gz::msgs::WorldStatistics &m){receive("stats",m);});
+ node.Subscribe<gz::msgs::Pose_V>("/world/default/pose/info",[&](const gz::msgs::Pose_V &m){receive("pose",m);});
+ node.Subscribe<gz::msgs::Scene>("/world/default/scene/info",[&](const gz::msgs::Scene &m){receive("scene",m);});
+#ifdef CMR_CAPTURE
+ node.Subscribe<gz::msgs::Contacts>("/cmr_probe/contacts",[&](const gz::msgs::Contacts &m){receive("contacts",m);});
+#endif
+ auto save=[&](J row){row["run_id"]=id;row["clock_epoch"]=epoch;row["seq"]=++rawseq;row["receive_monotonic_s"]=mono();raw<<row.dump()<<'\n';raw.flush();if(!raw)throw std::runtime_error("RAW_WRITE");};
+ auto pump=[&](){
+  std::deque<J> pending;{std::lock_guard<std::mutex> guard(mutex);pending.swap(queue);}
+  bool clock_updated=false;
+  for(const auto &r:pending){
+   const auto &p=r.at("protobuf");const std::string kind=r.at("kind");
+   if(kind=="stats"){paused=p.value("paused",false);stats_seen=true;if(p.contains("sim_time"))stats_clock=stamp(p.at("sim_time"));}
+   if(kind=="pose"){
+    const int64_t ts=stamp(p.at("header").at("stamp"));
+    if(p.contains("pose"))for(const auto &x:p.at("pose"))if(x.value("name",std::string())=="scripted_obstacle"){
+     uint64_t found=x.at("id").is_string()?std::stoull(x.at("id").get<std::string>()):x.at("id").get<uint64_t>();
+     if(entity&&*entity!=found)throw std::runtime_error("ENTITY_MISMATCH");
