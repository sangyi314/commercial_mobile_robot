+ emit("HELLO",{{"purpose","experimental_sidecar"},{"partition",std::getenv("GZ_PARTITION")}});
+ fcntl(STDIN_FILENO,F_SETFL,fcntl(STDIN_FILENO,F_GETFL)|O_NONBLOCK);
