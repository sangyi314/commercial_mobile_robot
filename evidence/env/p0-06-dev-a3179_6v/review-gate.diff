+     req.mutable_position()->set_x((*target)[0]);req.mutable_position()->set_y((*target)[1]);req.mutable_position()->set_z((*target)[2]);req.mutable_orientation()->set_w(1);
+     save({{"kind","request"},{"sim_ns",clock},{"planned_ns",scheduled},{"skipped_schedule_points",std::max(int64_t(0),(clock-scheduled)/timeline.period)},{"entity_id",*entity},{"entity_name","scripted_obstacle"},{"desired_xyz",*target},{"request",proto(req)}});
+     gate.begin(clock,mono());
+     std::function<void(const gz::msgs::Boolean&,bool)> cb=[&](const gz::msgs::Boolean &res,bool ok){std::lock_guard<std::mutex> guard(mutex);queue.push_back({{"kind","reply"},{"protobuf",{{"ok",ok&&res.data()},{"receive_monotonic_s",mono()}}}});};
+     if(!node.Request<gz::msgs::Pose,gz::msgs::Boolean>("/world/default/set_pose",req,cb))throw std::runtime_error("MOTION_SERVICE_UNAVAILABLE");
+    }
