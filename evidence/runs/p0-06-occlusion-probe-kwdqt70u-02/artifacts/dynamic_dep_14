{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunResult v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "record_origin": {
      "enum": [
        "real",
        "fixture"
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "status": {
      "type": "object",
      "properties": {
        "startup": {
          "enum": [
            "READY",
            "FAILED"
          ]
        },
        "action": {
          "enum": [
            "NOT_SENT",
            "REJECTED",
            "SUCCEEDED",
            "ABORTED",
            "CANCELED",
            "UNKNOWN"
          ]
        },
        "harness": {
          "enum": [
            "COMPLETED",
            "STARTUP_FAILED",
            "NAV_TIMEOUT",
            "RECORDER_FAILED",
            "INTERRUPTED",
            "INTERNAL_ERROR"
          ]
        },
        "cleanup": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "primary_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "startup",
        "action",
        "harness",
        "cleanup",
        "primary_reason"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actual_plugin": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "parameters_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "actual_plugin",
            "parameters_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "time": {
      "type": "object",
      "properties": {
        "clock_epoch": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sim_start_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sim_end_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_monotonic_s": {
          "type": "number",
          "minimum": 0
        },
        "rtf": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "sim_delta_s": {
                  "type": "number",
                  "minimum": 0
                },
                "monotonic_delta_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "value",
                "sim_delta_s",
                "monotonic_delta_s"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "clock_epoch",
        "sim_start_s",
        "sim_end_s",
        "elapsed_monotonic_s",
        "rtf"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "action_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_position_error_m": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_yaw_error_rad": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 3.141592653589793
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_observed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "intervention": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery_success": {
          "type": "null"
        }
      },
      "required": [
        "action_success",
        "goal_position_error_m",
        "goal_yaw_error_rad",
        "stop_observed",
        "intervention",
        "delivery_success"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "evaluator_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "geometry_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "clock_epoch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "interval_s": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number"
                },
                "end": {
                  "type": "number"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "enum": [
            "none",
            "partial",
            "full"
          ]
        },
        "evaluation_valid": {
          "type": "boolean"
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "collision": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "collision_event": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "at_s": {
                  "type": "number"
                },
                "objects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "at_s",
                "objects",
                "source_ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "min_signed_clearance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometric_contact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "contact_sensor_event": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "evaluator_version",
        "scope_id",
        "objects",
        "geometry_model",
        "frame_id",
        "clock_epoch",
        "interval_s",
        "coverage",
        "evaluation_valid",
        "invalid_reason",
        "evidence_refs",
        "collision",
        "collision_event",
        "min_signed_clearance_m",
        "geometric_contact",
        "contact_sensor_event"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "record_origin",
    "manifest_sha256",
    "status",
    "runtime",
    "time",
    "metrics",
    "evaluation",
    "artifacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "kind": {
          "enum": [
            "scenario",
            "config",
            "common_constraints",
            "source_snapshot",
            "runtime_parameters",
            "log",
            "bag_metadata",
            "evaluation",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
