{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "record_origin": {
      "enum": [
        "real",
        "fixture"
      ]
    },
    "scenario": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scenario_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "scenario_id",
        "scenario_revision",
        "spec_sha256"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "git_commit",
        "dirty",
        "snapshot_ref"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "mppi",
            "dwb"
          ]
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "expected_plugin": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "common_constraints_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "method",
        "config_sha256",
        "expected_plugin",
        "common_constraints_sha256"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "ros_distro": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "package_versions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "external_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "controller_seed_controlled": {
          "type": "boolean"
        }
      },
      "required": [
        "ros_distro",
        "platform",
        "package_versions",
        "external_seed",
        "seed_scope",
        "controller_seed_controlled"
      ],
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "clock_epoch": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "started_at_utc": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sim_start_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "clock_epoch",
        "started_at_utc",
        "sim_start_s"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "record_origin",
    "scenario",
    "source",
    "baseline",
    "environment",
    "clock",
    "artifacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "kind": {
          "enum": [
            "scenario",
            "config",
            "common_constraints",
            "source_snapshot",
            "runtime_parameters",
            "log",
            "bag_metadata",
            "evaluation",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
