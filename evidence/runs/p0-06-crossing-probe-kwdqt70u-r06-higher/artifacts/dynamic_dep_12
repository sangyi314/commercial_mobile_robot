{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P0-06 dynamic recording evidence, not collision evaluation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "probe",
        "navigation_recording",
        null
      ]
    },
    "record_origin": {
      "enum": [
        "real",
        "fixture",
        null
      ]
    },
    "collision": {
      "type": "null"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dynamic_recording_valid": {
      "type": "boolean"
    },
    "probe_pass": {
      "type": "boolean"
    },
    "motion_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "time_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "observation_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "entity_mapping": {
      "type": "object"
    },
    "clock_alignment": {
      "type": "object"
    },
    "trajectory": {
      "type": "object"
    },
    "crossing": {
      "type": "object"
    },
    "probe_facilities": {
      "type": "object"
    },
    "analysis_window": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "purpose",
    "dynamic_recording_valid",
    "probe_pass",
    "motion_valid",
    "time_valid",
    "observation_valid",
    "collision",
    "errors",
    "frames",
    "source_files"
  ],
  "additionalProperties": false
}
